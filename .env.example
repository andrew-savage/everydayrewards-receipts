# ---- Everyday Receipts configuration (copy to .env) ----

# Host folder that receives the PDFs. Share this folder via NFS and point
# paperless-ngx's consume directory at it.
RECEIPTS_DIR=./receipts

# Host folder for the app's private state (tokens, seen-receipt list, JSON sidecars).
DATA_DIR=./data

# Run the container as this uid:gid so files land with the right ownership
# for your NFS export / paperless consumer.
PUID=1000
PGID=1000

# Timezone used for receipt dates in filenames.
TZ=Australia/Melbourne

# How often to look for new receipts (s/m/h/d suffix). Woolworths only issues a
# few receipts a day at most, so 6h is plenty.
EDR_POLL_INTERVAL=6h

# Filename template. Fields: {date} {partner} {store} {amount} {short_id} {receipt_id} {id}
# EDR_FILENAME_TEMPLATE={date} {partner} {store} {amount} [{short_id}]

# Put receipts in a per-partner sub-folder (Woolworths/, BWS/, Big W/ ...).
# Pair with PAPERLESS_CONSUMER_RECURSIVE=true and PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true.
# EDR_SUBDIR_BY_PARTNER=false

# Keep an itemised JSON copy of each receipt next to the app state (not in the consume folder).
# Set to "off" to disable.
# EDR_JSON_DIR=/data/json

# Walk the whole history on every run instead of stopping at the first page
# of already-seen receipts.
# EDR_FULL_SCAN=false

# Non-interactive alternative to `import-app-token`: the mobile app's Auth0
# /oauth/token JSON response. Used only when no session is stored yet. Prefer
# running `import-app-token` so the token is stored in data/tokens.json instead.
# EDR_APP_TOKEN_JSON={"access_token":"...","refresh_token":"...","expires_in":86400}

# Feed source: "rest" (default, works with an app token) or "graphql" (web session only).
# EDR_FEED_MODE=rest

# EDR_LOG_LEVEL=INFO
